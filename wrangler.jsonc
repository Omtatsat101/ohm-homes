{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ohm-homes",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  // Custom domain: bound after first deploy via `wrangler deploy` then
  // Cloudflare dashboard → Workers & Pages → ohm-homes → Settings → Triggers
  // → Add Custom Domain → ohm.homes
  // (Only works once the domain is on Cloudflare nameservers.)
  "routes": [
    // { "pattern": "ohm.homes", "custom_domain": true }
  ],

  // Cron triggers — scheduled() in src/index.ts branches on controller.cron:
  //   "*/30 * * * *"  → every 30 min, drains the application follow-up queue
  //                     (Supabase application_followups) and posts Slack cards
  //   "15 9 * * *"    → daily at 09:15 UTC (~5am ET / ~4am CT), auto-queues
  //                     7-day check-ins for any application where sent_at is
  //                     more than 7 days ago and no check-in row exists yet
  // To disable temporarily, empty this array and `wrangler deploy`. The HTTP
  // endpoints stay live for manual triggering.
  "triggers": {
    "crons": ["*/30 * * * *", "15 9 * * *"]
  }

  // Bindings to add later (after first deploy + dashboard provisioning):
  // "kv_namespaces": [{ "binding": "STATE", "id": "<from kv_namespace_create>" }],
  // "d1_databases": [{ "binding": "DB", "database_name": "ohm_internal", "database_id": "<from d1_database_create>" }],
  // "r2_buckets": [{ "binding": "ASSETS_R2", "bucket_name": "ohm-product-images" }]
}
